<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="referrer" content="no-referrer">
<title>暗号の棚卸しレポート {{.Host}}</title>
<style>
:root {
  --fg:#1b2430; --sub:#5a6575; --line:#dde2ea; --bg:#f3f5f8; --paper:#ffffff; --panel:#f7f9fc; --accent:#1f4e8c; --head:#16314f;
  --bad:#a8231b; --badbg:#fdecea; --warn:#8a5600; --warnbg:#fff3da; --good:#19693a; --goodbg:#e4f5ea; --unk:#474c94; --unkbg:#ecedfb;
}
@media (prefers-color-scheme: dark) {
  :root {
    --fg:#e6eaf0; --sub:#9aa6b6; --line:#333c49; --bg:#12161c; --paper:#1a2029; --panel:#202733; --accent:#8fb8ef; --head:#0e1620;
    --bad:#ff9d94; --badbg:#47201d; --warn:#f2c36b; --warnbg:#42341a; --good:#84d6a3; --goodbg:#193826; --unk:#b9bdf7; --unkbg:#2a2c55;
  }
}
* { box-sizing: border-box; }
html { scroll-behavior: smooth; scroll-padding-top: 56px; }
body { margin: 0; color: var(--fg); background: var(--bg); font: 15px/1.65 system-ui, -apple-system, "Hiragino Sans", "Yu Gothic UI", "Meiryo", "Noto Sans JP", sans-serif; -webkit-text-size-adjust: 100%; }
header.top { background: var(--head); color: #fff; padding: 22px 20px 18px; }
header.top .in, main, nav.toc .in { max-width: 1200px; margin: 0 auto; }
header.top h1 { font-size: 22px; margin: 0 0 4px; letter-spacing: .02em; }
header.top p { margin: 0; color: #c9d5e4; font-size: 13px; }
nav.toc { position: sticky; top: 0; z-index: 5; background: var(--paper); border-bottom: 1px solid var(--line); padding: 0 20px; }
nav.toc .in { display: flex; flex-wrap: wrap; gap: 2px 4px; }
nav.toc a { display: inline-block; padding: 10px 10px; font-size: 13px; color: var(--fg); text-decoration: none; border-bottom: 3px solid transparent; }
nav.toc a:hover, nav.toc a:focus { border-bottom-color: var(--accent); color: var(--accent); }
main { padding: 8px 20px 64px; }
section.block { background: var(--paper); border: 1px solid var(--line); border-radius: 10px; padding: 6px 20px 16px; margin: 18px 0; }
h2 { font-size: 18px; margin: 16px 0 10px; padding-left: 10px; border-left: 5px solid var(--accent); line-height: 1.4; }
h3 { font-size: 16px; margin: 20px 0 6px; }
h4 { font-size: 14px; margin: 16px 0 4px; color: var(--sub); font-weight: 600; }
p { margin: 6px 0; }
.sub { color: var(--sub); font-size: 13px; }
.meta { display: grid; grid-template-columns: max-content 1fr; gap: 3px 18px; font-size: 13.5px; margin: 10px 0; }
.meta dt { color: var(--sub); }
.meta dd { margin: 0; overflow-wrap: anywhere; }
.alert { border: 2px solid var(--bad); background: var(--badbg); color: var(--fg); padding: 12px 16px; border-radius: 8px; margin: 16px 0; font-size: 15px; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; margin: 12px 0 4px; }
.card { border: 1px solid var(--line); border-top: 4px solid var(--accent); border-radius: 8px; padding: 12px 16px; background: var(--panel); }
.card h3 { margin: 0 0 8px; font-size: 14px; }
.card ul { margin: 0 0 6px; padding: 0; list-style: none; font-size: 14px; }
.card li { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 3px 0; border-bottom: 1px dotted var(--line); }
.card li:last-child { border-bottom: 0; }
.num { font-variant-numeric: tabular-nums; font-weight: 700; font-size: 17px; min-width: 2.2em; text-align: right; }
.num.zero { color: var(--sub); font-weight: 400; font-size: 15px; }
.num.bad { color: var(--bad); }
.num.warn { color: var(--warn); }
.num.good { color: var(--good); }
.num.unk { color: var(--unk); }
.tablewrap { overflow-x: auto; margin: 6px 0 12px; }
table { border-collapse: collapse; width: 100%; font-size: 13px; }
th, td { border-bottom: 1px solid var(--line); padding: 6px 10px; text-align: left; vertical-align: top; overflow-wrap: anywhere; }
th { background: var(--panel); font-weight: 600; white-space: nowrap; border-top: 1px solid var(--line); color: var(--sub); font-size: 12.5px; }
tr:nth-child(even) td { background: var(--panel); }
tr:hover td { background: var(--unkbg); }
td.mono, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, "Courier New", monospace; font-size: 12.5px; }
.badge { display: inline-block; padding: 0 8px; border-radius: 11px; font-size: 12px; line-height: 1.75; white-space: nowrap; border: 1px solid transparent; font-weight: 600; }
.badge.bad { color: var(--bad); background: var(--badbg); border-color: var(--bad); }
.badge.warn { color: var(--warn); background: var(--warnbg); border-color: var(--warn); }
.badge.good { color: var(--good); background: var(--goodbg); border-color: var(--good); }
.badge.unk { color: var(--unk); background: var(--unkbg); border-color: var(--unk); }
.badge.none { color: var(--sub); background: transparent; border-color: var(--line); font-weight: 400; }
.svc { border: 1px solid var(--line); border-radius: 8px; padding: 2px 16px 10px; margin: 14px 0; background: var(--paper); }
.svc > h3 { margin-top: 14px; font-size: 17px; }
.scope { border-left: 4px solid var(--line); padding: 2px 0 2px 14px; margin: 16px 0; }
.scope > h4 { color: var(--fg); font-size: 14.5px; }
details { margin: 8px 0; border: 1px solid var(--line); border-radius: 8px; background: var(--paper); }
details > summary { cursor: pointer; padding: 9px 14px; font-size: 14px; color: var(--accent); font-weight: 600; }
details > summary:hover { background: var(--panel); }
details > *:not(summary) { margin-left: 14px; margin-right: 14px; }
.steps { margin: 4px 0 6px; padding-left: 22px; font-size: 13px; color: var(--sub); }
.reasons { margin: 2px 0 12px; padding-left: 22px; font-size: 12.5px; color: var(--sub); }
.note { font-size: 13px; color: var(--warn); }
ul.plain { margin: 6px 0; padding-left: 22px; }
ul.plain li { margin: 4px 0; }
a { color: var(--accent); }
footer { max-width: 1200px; margin: 0 auto; padding: 0 20px 40px; color: var(--sub); font-size: 12px; }
@media print {
  :root { --bg:#ffffff; }
  body { font-size: 11.5px; }
  nav.toc { display: none; }
  header.top { background: none; color: #000; padding: 0 0 8px; border-bottom: 2px solid #000; }
  header.top p { color: #333; }
  section.block { border: 0; padding: 0; }
  .svc, .card, tr { break-inside: avoid; }
  details { border: 0; }
  tr:hover td { background: transparent; }
}
</style>
</head>
<body>
<header class="top"><div class="in">
<h1>暗号の棚卸しレポート: {{.Host}}</h1>
<p>kagiya による 1 ホスト分のスキャン結果。設定から分かるのは「許可されている」暗号までで、実際の通信でどれが使われているかを示すものではありません。</p>
</div></header>
<nav class="toc"><div class="in">
<a href="#summary">要点</a><a href="#services">サービスの設定</a><a href="#files">証明書と鍵</a><a href="#system">OS とライブラリ</a><a href="#coverage">調べられなかった範囲</a><a href="#limits">分からないこと</a><a href="#criteria">判定の基準と出典</a>
</div></nav>
<main>
<section class="block">
<h2 id="overview">スキャンの概要</h2>
{{if .Incomplete}}<div class="alert"><strong>このスキャンは完了していません。</strong>結果は途中までのものです{{if .IncompleteReason}}（理由: {{.IncompleteReason}}）{{end}}。</div>{{end}}

<dl class="meta">
<dt>ホスト</dt><dd>{{.Host}}（{{.OSArch}}）</dd>
<dt>スキャンの開始 / 終了</dt><dd>{{.Started}} / {{.Finished}}</dd>
<dt>ツールの版</dt><dd>{{.ToolVersion}}</dd>
<dt>検出ルールの版</dt><dd>{{.RulesVersion}}（{{.RulesSource}}）</dd>
<dt>評価の基準</dt><dd>{{.PolicyTitle}}（版 {{.PolicyVersion}}）。このレポートを作った時点の基準で判定しています</dd>
<dt>実行した権限</dt><dd>{{if .Elevated}}管理者権限{{else}}一般ユーザー（権限がなく読めないファイルは結果に含まれません）{{end}}</dd>
{{if .Labels}}<dt>ラベル</dt><dd>{{range $i, $l := .Labels}}{{if $i}}、{{end}}{{$l}}{{end}}</dd>{{end}}
</dl>
{{range .Warnings}}<p class="note">注意: {{.}}</p>{{end}}

</section>
<section class="block">
<h2 id="summary">要点</h2>
<div class="cards">
<div class="card">
<h3>起動するよう設定されたサービスの設定（{{.Summary.ActiveServices}} サービス）</h3>
<ul>
<li><span>鍵共有が量子計算機に弱い方式</span><span class="num{{if .Summary.KeyEstablishment}} bad{{else}} zero{{end}}">{{.Summary.KeyEstablishment}}</span></li>
<li><span>その他の量子計算機に弱い方式（署名など）</span><span class="num{{if .Summary.QuantumOther}} bad{{else}} zero{{end}}">{{.Summary.QuantumOther}}</span></li>
<li><span>ハイブリッドの方式</span><span class="num{{if .Summary.Hybrid}} good{{else}} zero{{end}}">{{.Summary.Hybrid}}</span></li>
<li><span>危殆化している方式・プロトコル</span><span class="num{{if .Summary.Weak}} bad{{else}} zero{{end}}">{{.Summary.Weak}}</span></li>
<li><span>非推奨の方式</span><span class="num{{if .Summary.Legacy}} warn{{else}} zero{{end}}">{{.Summary.Legacy}}</span></li>
<li><span>判定できない方式</span><span class="num{{if .Summary.Unknown}} unk{{else}} zero{{end}}">{{.Summary.Unknown}}</span></li>
<li><span>実際に効く値を求められなかった項目</span><span class="num{{if .Summary.Unresolved}} unk{{else}} zero{{end}}">{{.Summary.Unresolved}}</span></li>
</ul>
<p class="sub">数は、サービス・範囲ごとに許可されている方式の延べ数です。鍵共有が量子計算機に弱いと、いま記録された通信が将来解読され得ます。</p>
</div>
<div class="card">
<h3>ファイルとして見つかった証明書・鍵（証明書ストアを除く）</h3>
<ul>
<li><span>量子計算機に弱い</span><span class="num{{if .Summary.FileQuantum}} bad{{else}} zero{{end}}">{{.Summary.FileQuantum}}</span></li>
<li><span>危殆化している</span><span class="num{{if .Summary.FileWeak}} bad{{else}} zero{{end}}">{{.Summary.FileWeak}}</span></li>
<li><span>非推奨</span><span class="num{{if .Summary.FileLegacy}} warn{{else}} zero{{end}}">{{.Summary.FileLegacy}}</span></li>
<li><span>期限切れの証明書</span><span class="num{{if .Summary.Expired}} bad{{else}} zero{{end}}">{{.Summary.Expired}}</span></li>
<li><span>{{.ExpiringDays}} 日以内に期限が来る証明書</span><span class="num{{if .Summary.Expiring}} warn{{else}} zero{{end}}">{{.Summary.Expiring}}</span></li>
<li><span>参照されていない秘密鍵</span><span class="num{{if .Summary.Unreferenced}} warn{{else}} zero{{end}}">{{.Summary.Unreferenced}}</span></li>
</ul>
<p class="sub">期限は、スキャンした時点（{{.Finished}}）を基準に判定しています。</p>
</div>
<div class="card">
<h3>調べられた範囲</h3>
<ul>
<li><span>調べたファイル</span><span class="num">{{.Coverage.FilesExamined}}</span></li>
<li><span>調べたディレクトリ</span><span class="num">{{.Coverage.DirsExamined}}</span></li>
<li><span>調べられなかった箇所</span><span class="num{{if .Summary.Skipped}} warn{{else}} zero{{end}}">{{.Summary.Skipped}}</span></li>
</ul>
<p class="sub">詳しくは「<a href="#coverage">調べられなかった範囲</a>」と「<a href="#limits">このレポートでは分からないこと</a>」を見てください。</p>
</div>
</div>

</section>
<section class="block">
<h2 id="services">サービスの設定</h2>
{{if and (not .Active) (not .Inactive)}}<p>サービスは見つかりませんでした。</p>{{end}}
{{range .Active}}
<section class="svc">
<h3>{{.Name}} <span class="badge good">{{.Activity}}</span></h3>
{{template "service" .}}
</section>
{{end}}
{{range .Inactive}}
<details>
<summary>{{.Name}}（{{.Activity}}。起動するよう設定されていないサービス）</summary>
<section class="svc">
{{template "service" .}}
</section>
</details>
{{end}}

</section>
<section class="block">
<h2 id="files">証明書と鍵</h2>
{{if .Unreferenced}}
<h3>参照されていない秘密鍵（{{len .Unreferenced}} 件）</h3>
<p class="sub">どのサービスの設定からも参照されていない秘密鍵です。使われていないなら、置いたままにする理由がないか確認してください。</p>
{{template "assets" .Unreferenced}}
{{end}}
<h3>ファイルとして見つかったもの（{{len .Files}} 件）</h3>
{{if .Files}}{{template "assets" .Files}}{{else}}<p>証明書ストアの外では、証明書や鍵は見つかりませんでした。</p>{{end}}

{{if .Stores}}
<h3>証明書ストア</h3>
<p class="sub">OS や実行環境が信頼する CA 証明書の置き場です。件数が多いので畳んでいます。中は署名の方式ごとにまとめています。</p>
{{range .Stores}}
<details>
<summary>{{.Name}}（{{.Count}} 件）</summary>
{{range .Groups}}
<h4>署名 {{.Signature}}（{{.Count}} 件）{{if .Quantum.Label}} <span class="badge {{.Quantum.Class}}">{{.Quantum.Label}}</span>{{end}}{{if .Classical.Label}} <span class="badge {{.Classical.Class}}">{{.Classical.Label}}</span>{{end}}</h4>
<div class="tablewrap"><table>
<tr><th>種類</th><th>名前</th><th>アルゴリズム</th><th>有効期限</th><th>場所</th></tr>
{{range .Rows}}<tr><td>{{.Kind}}</td><td>{{.Name}}</td><td class="mono">{{.Algorithm}}</td><td>{{.Expiry}}{{if .ExpiryTag.Label}} <span class="badge {{.ExpiryTag.Class}}">{{.ExpiryTag.Label}}</span>{{end}}</td><td class="mono">{{.Path}}</td></tr>
{{end}}</table></div>
{{end}}
</details>
{{end}}
{{end}}

</section>
<section class="block">
<h2 id="system">OS とライブラリ</h2>
{{if .OSSettings}}
<h3>OS 全体の暗号設定</h3>
<div class="tablewrap"><table><tr><th>項目</th><th>値</th><th>場所</th></tr>
{{range .OSSettings}}<tr><td class="mono">{{.Key}}</td><td class="mono">{{.Value}}</td><td class="mono">{{.Where}}</td></tr>
{{end}}</table></div>
{{end}}
{{if .Components}}
<h3>アプリケーションと暗号ライブラリ</h3>
<div class="tablewrap"><table><tr><th>名前</th><th>場所と版</th><th>リンクしている暗号ライブラリ</th></tr>
{{range .Components}}<tr><td>{{.Key}}</td><td class="mono">{{.Value}}</td><td class="mono">{{.Where}}</td></tr>
{{end}}</table></div>
{{end}}
{{if .Packages}}
<h3>暗号に関係するパッケージ</h3>
<div class="tablewrap"><table><tr><th>パッケージ</th><th>版</th><th>管理方式</th></tr>
{{range .Packages}}<tr><td class="mono">{{.Key}}</td><td class="mono">{{.Value}}</td><td>{{.Where}}</td></tr>
{{end}}</table></div>
{{end}}
{{if and (not .OSSettings) (not .Components) (not .Packages)}}<p>該当する情報はありませんでした。</p>{{end}}

</section>
<section class="block">
<h2 id="coverage">調べられなかった範囲</h2>
{{if .SkippedBy}}
<div class="tablewrap"><table><tr><th>理由</th><th>件数</th></tr>
{{range .SkippedBy}}<tr><td class="mono">{{.Key}}</td><td>{{.Value}}</td></tr>
{{end}}</table></div>
{{else}}<p>読み飛ばした箇所は記録されていません。</p>{{end}}
{{if .Skipped}}
<details>
<summary>読み飛ばした場所の一覧（{{len .Skipped}} 件{{if .SkippedCut}}。件数が多いため一部だけを載せています。全件はスキャンのログにあります{{end}}）</summary>
<div class="tablewrap"><table><tr><th>場所</th><th>理由</th><th>詳細</th></tr>
{{range .Skipped}}<tr><td class="mono">{{.Key}}</td><td class="mono">{{.Value}}</td><td class="mono">{{.Where}}</td></tr>
{{end}}</table></div>
</details>
{{end}}
<p class="sub">調べたファイル {{.Coverage.FilesExamined}}、ディレクトリ {{.Coverage.DirsExamined}}、辿らなかったシンボリックリンク {{.Coverage.SymlinksIgnored}}、開かなかった特殊ファイル {{.Coverage.SpecialIgnored}}。</p>

</section>
<section class="block">
<h2 id="limits">このレポートでは分からないこと</h2>
<ul class="plain">
<li>実際にネゴシエーションされている暗号。設定から分かるのは「許可されている」ものまでで、相手との間でどれが選ばれているかは通信を観測しないと分かりません。</li>
<li>サービスが実際に動いているか。「有効」は起動するよう設定されているという意味で、止まっていることも、手動で動かされていることもあり得ます。</li>
<li>どのプロトコルの版（TLS 1.0〜1.3）が実際に通るか。プロトコルは設定に書かれた値を示すにとどめています。暗号スイートは、いずれかの版が有効なら受け入れ得るものの一覧です。</li>
<li>クライアントとしての利用。定期実行されるスクリプトなどからの暗号の利用は、サービスとしては見えません。</li>
<li>ネットワーク越しのファイルシステム上のもの、権限がなく読めなかったもの、パスワードで保護されたキーストアの中身。</li>
<li>証明書の信頼性。署名の検証、信頼の連鎖、失効は確認していません。自己署名のルート証明書の署名方式は、判定には出ますが、安全性には影響しません。</li>
<li>確度が「中」の値は、近い版での実測を当てはめたか、証明書などを読めずに絞り込みの一部を行っていません。</li>
</ul>
<p class="sub">判定は、下の文書に照らした目安です。個々のシステムで移行が必要か、いつまでに行うかは、扱う情報と利用期間に応じて判断してください。</p>

</section>
<section class="block">
<h2 id="criteria">判定の基準と出典</h2>
{{if .Rules}}
<h3>このレポートで使った判定</h3>
<div class="tablewrap"><table><tr><th>判定の理由</th><th>根拠にした文書</th></tr>
{{range .Rules}}<tr><td>{{.Summary}}</td><td>{{range $i, $r := .Refs}}{{if $i}}<br>{{end}}{{$r}}{{end}}</td></tr>
{{end}}</table></div>
{{end}}
<h3>文書</h3>
<div class="tablewrap"><table><tr><th>文書</th><th>該当する内容</th></tr>
{{range .Refs}}<tr><td>{{.Title}}<br><a href="{{.URL}}" rel="noopener noreferrer">{{.URL}}</a></td><td>{{.Note}}</td></tr>
{{end}}</table></div>
</section>
</main>
<footer>このファイルは外部の資源を読み込みません。スキャン結果は機密として扱ってください。</footer>
</body>
</html>
{{define "values"}}
<div class="tablewrap"><table>
{{if .IsSuite}}<tr><th>スイート</th><th>鍵交換</th><th>認証</th><th>暗号化</th><th>量子計算機に対して</th><th>現在の計算機に対して</th></tr>
{{range .Rows}}<tr><td class="mono">{{.Name}}</td><td class="mono">{{.Kx}}</td><td class="mono">{{.Au}}</td><td class="mono">{{.Enc}}</td><td>{{if .HasVerdict}}<span class="badge {{.Quantum.Class}}">{{.Quantum.Label}}</span>{{end}}</td><td>{{if .HasVerdict}}<span class="badge {{.Classical.Class}}">{{.Classical.Label}}</span>{{end}}</td></tr>
{{end}}{{else}}<tr><th>値</th><th>量子計算機に対して</th><th>現在の計算機に対して</th></tr>
{{range .Rows}}<tr><td class="mono">{{.Name}}</td><td>{{if .HasVerdict}}<span class="badge {{.Quantum.Class}}">{{.Quantum.Label}}</span>{{end}}</td><td>{{if .HasVerdict}}<span class="badge {{.Classical.Class}}">{{.Classical.Label}}</span>{{end}}</td></tr>
{{end}}{{end}}</table></div>
{{if .Reasons}}<ul class="reasons">{{range .Reasons}}<li>{{.Summary}}</li>{{end}}</ul>{{end}}
{{end}}

{{define "service"}}
<dl class="meta">
{{if .Evidence}}<dt>根拠</dt><dd>{{range $i, $e := .Evidence}}{{if $i}}<br>{{end}}{{$e}}{{end}}</dd>{{end}}
{{if .Component}}<dt>プログラム</dt><dd class="mono">{{.Component}}</dd>{{end}}
{{if .Configs}}<dt>設定ファイル</dt><dd class="mono">{{range $i, $c := .Configs}}{{if $i}}、{{end}}{{$c}}{{end}}</dd>{{end}}
</dl>
{{range .Notes}}<p class="note">注意: {{.}}</p>{{end}}
{{if not .Scopes}}<p class="sub">暗号に関する設定は見つかりませんでした。</p>{{end}}
{{range .Scopes}}
<div class="scope">
<h4>{{if .Name}}範囲: {{.Name}}{{else}}全体{{end}}</h4>
{{range .Effective}}
<p><strong>{{.Label}}</strong>{{if .Resolved}}（実際に効く値。{{.Confidence}}）{{else}} <span class="badge unk">求められませんでした</span>{{end}}</p>
{{if not .Resolved}}<p class="note">理由: {{.Reason}}</p>{{end}}
{{range .Notes}}<p class="note">注意: {{.}}</p>{{end}}
{{if .Steps}}<ol class="steps">{{range .Steps}}<li>{{.}}</li>{{end}}</ol>{{end}}
{{if .Resolved}}{{if .Fold}}<details><summary>{{.Counts}}（一覧を開く）</summary>{{template "values" .}}</details>{{else}}<p class="sub">{{.Counts}}</p>{{template "values" .}}{{end}}{{end}}
{{end}}
{{if .Settings}}
<div class="tablewrap"><table>
<tr><th>設定に書かれている項目</th><th>値</th><th>場所</th></tr>
{{range .Settings}}<tr><td>{{.Label}}{{if .Shadowed}}（他の記載が優先され、効いていない）{{end}}</td><td class="mono">{{.Values}}{{range .Badges}}{{if eq .Classical.Class "bad"}} <span class="badge bad">{{.Name}}: {{.Classical.Label}}</span>{{end}}{{end}}</td><td class="mono">{{.Location}}</td></tr>
{{end}}</table></div>
{{end}}
</div>
{{end}}
{{end}}

{{define "assets"}}
<div class="tablewrap"><table>
<tr><th>種類</th><th>名前</th><th>アルゴリズム</th><th>有効期限</th><th>場所</th><th>利用の確からしさ</th><th>判定</th></tr>
{{range .}}<tr><td>{{.Kind}}</td><td>{{.Name}}</td><td class="mono">{{.Algorithm}}</td><td>{{.Expiry}}{{if .ExpiryTag.Label}} <span class="badge {{.ExpiryTag.Class}}">{{.ExpiryTag.Label}}</span>{{end}}</td><td class="mono">{{.Path}}</td><td>{{.Activity}}{{range .Evidence}}<br><span class="sub">{{.}}</span>{{end}}</td><td>{{if .Quantum.Label}}<span class="badge {{.Quantum.Class}}">{{.Quantum.Label}}</span> {{end}}{{if .Classical.Label}}<span class="badge {{.Classical.Class}}">{{.Classical.Label}}</span>{{end}}</td></tr>
{{end}}</table></div>
{{end}}
